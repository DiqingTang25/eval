# ═══════════════════════════════════════════════════════════════
# AI Agent 评测系统 — 环境变量模板
#
# 部署模式: systemd + venv (主方案, 生产使用中)
#           Docker (备用方案, 见 deploy/README.md)
# ═══════════════════════════════════════════════════════════════

# ── LLM API (DeepSeek via OpenAI-compatible) ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── XJTLU AI Gateway 多模型Judge (君谋智能体, 跨模型族投票, 免费校内资源) ──
# 网关统一端点, 每个模型独立API Key + Model ID
XJTLU_BASE_URL=https://aiagent.xjtlu.edu.cn/api/aigw/v1
XJTLU_JUDGE_GLM52_API_KEY=your-api-key
XJTLU_JUDGE_GLM52_MODEL_ID=your-model-id
XJTLU_JUDGE_DOUBAO_API_KEY=your-api-key
XJTLU_JUDGE_DOUBAO_MODEL_ID=your-model-id

# ── XJTLU Embedding (校内向量模型, L2语义相似度) ──
XJTLU_EMBEDDING_API_KEY=your-api-key
XJTLU_EMBEDDING_MODEL_ID=your-model-id

# ── SILICONFLOW API (Embedding模型, bge-m3) ──
# 注册地址: https://siliconflow.cn
SILICONFLOW_API_KEY=sk-your-key-here

# ── 数据库类型: sqlite (本地零配置) / mysql (云端RDS) ──
DB_TYPE=sqlite

# MySQL 连接（DB_TYPE=mysql 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agent_eval
MYSQL_PASSWORD=your-password-here
MYSQL_DB=agent_eval

# ── HIAGENT (被测Agent - 西交利物浦教学AI助手) ──
HIAGENT_URL=https://aiagent.xjtlu.edu.cn/product/llm/chat/your-chat-id
HIAGENT_APP_ID=your-app-id
HIAGENT_API_KEY=your-api-key

# ── HiAgent Phase Agent REST API (按Phase分) ──
HIAGENT_PHASE1_APPID=your-app-id
HIAGENT_PHASE1_APIKEY=your-api-key
HIAGENT_PHASE2_APPID=your-app-id
HIAGENT_PHASE2_APIKEY=your-api-key
HIAGENT_PHASE3_4_APPID=your-app-id
HIAGENT_PHASE3_4_APIKEY=your-api-key
HIAGENT_PHASE5_APPID=your-app-id
HIAGENT_PHASE5_APIKEY=your-api-key

# ── 火山引擎知识库 (向量KB, HMAC-SHA256签名认证) ──
# 获取 AK/SK: 火山引擎控制台 → 右上角头像 → API访问密钥
VOLC_ACCESS_KEY=your-access-key
VOLC_SECRET_KEY=your-secret-key
VOLC_KB_DOMAIN=api-knowledgebase.mlp.cn-beijing.volces.com
VOLC_KB_SERVICE_ID=kb-service-your-id
VOLC_SERVICE=air
VOLC_REGION=cn-north-1

# ── 火山引擎知识库 (5个Phase课程KB) ──
VOLC_KB_PHASE1_KEY=your-key
VOLC_KB_PHASE1_ID=kb-your-id
VOLC_KB_PHASE2_KEY=your-key
VOLC_KB_PHASE2_ID=kb-your-id
VOLC_KB_PHASE3_4_KEY=your-key
VOLC_KB_PHASE3_4_ID=kb-service-your-id
VOLC_KB_PHASE5_KEY=your-key
VOLC_KB_PHASE5_ID=kb-service-your-id

# ── Phase 2: 证据记忆KB (复用已有Phase KB, 零额外费用) ──
# 不需要创建新KB! 选择一个已有Phase KB承载记忆数据:
#   phase1 → 复用 Phase 1 的KB (推荐, 课程内容最丰富)
#   phase2 / phase3_4 / phase5 → 复用其他Phase的KB
# 记忆数据使用独立的 collection name (evaluation_memory), 与课程内容互不干扰
VOLC_KB_MEMORY_SOURCE=phase1
VOLC_KB_MEMORY_NAME=evaluation_memory

# ── Playwright 代理 (WSL2 环境需要) ──
PLAYWRIGHT_PROXY=http://172.21.176.1:7897

# ── Redis 缓存 (可选, 不配置则使用内存缓存) ──
# REDIS_URL=redis://localhost:6379/0

# ── Auth (Basic Auth, 保护API) ──
# ⚠️ 生产环境必须设置强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-in-production

# ── 被测试实训平台 ──
PLATFORM_URL=http://your-platform-ip
PLATFORM_USERNAME=your-username
PLATFORM_PASSWORD=your-password
