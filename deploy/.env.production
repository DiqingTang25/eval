# ================================================================
# AI Agent 评测系统 — 生产环境变量
# 复制此文件为 .env 并填入实际值
# ================================================================

# ── LLM API (DeepSeek — OpenAI 兼容格式) ──
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── 数据库 (火山引擎 MySQL RDS) ──
DB_TYPE=mysql
MYSQL_HOST=your-instance.rds.ivolces.com
MYSQL_PORT=3306
MYSQL_USER=agent_eval
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DB=agent_eval

# ── 火山引擎知识库 (向量KB — 已配置) ──
VOLC_KB_DOMAIN=api-knowledgebase.mlp.cn-beijing.volces.com
VOLC_KB_SERVICE_ID=YOUR_KB_SERVICE_ID
VOLC_ACCESS_KEY=YOUR_ACCESS_KEY
VOLC_SECRET_KEY=YOUR_SECRET_KEY
VOLC_SERVICE=air
VOLC_REGION=cn-north-1

# ── HIAGENT (西交利物浦教学AI助手) ──
HIAGENT_URL=https://aiagent.xjtlu.edu.cn/product/llm/mall/application/YOUR_HIAGENT_APP_ID/chat
HIAGENT_APP_ID=YOUR_HIAGENT_APP_ID
HIAGENT_API_KEY=YOUR_HIAGENT_API_KEY
HIAGENT_SECRET=YOUR_HIAGENT_SECRET

# ── 评测配置 ──
# 云服务器无显示器，必须使用 headless 模式
PLAYWRIGHT_HEADLESS=true
# 云服务器在国内，不需要代理访问 Vercel
# PLAYWRIGHT_PROXY 留空即可

# ── 安全认证 ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_STRING
